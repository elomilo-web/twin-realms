{
  "_help": "Character models (scripts/Avatar.cs). Bodies, hair and outfit parts share one skeleton, so gear parts deform with the body. Gear is matched by keywords in the item name (first match wins). 'parts' are outfit glTF names in assets/models/outfit ({s} = Male/Female). 'tint' multiplies the part colours. 'kit' = rigid Twin Realms kit pieces on a bone ({model, bone, pos, rot, scale}, pos/rot like 'hold'; tune with tools/run.ps1 fit-tune). 'proc' = a procedural shape, used when there is no kit piece. Weapons: model is grip-at-origin, blade along +Z; 'len' is the length in metres. Trinkets are never shown.",
  "bodies": {
    "male": "res://assets/models/char/Superhero_Male_FullBody.gltf",
    "female": "res://assets/models/char/Superhero_Female_FullBody.gltf"
  },
  "height": 1.82,
  "raceFeatures": false,
  "_raceFeaturesHelp": "true = add the procedural cones for pointy ears, tusks and horns (data/races.json look). Off: they stuck out of heads.",
  "hair": {
    "male": ["Hair_SimpleParted", "Hair_Buzzed", "Hair_Long"],
    "female": ["Hair_Long", "Hair_Buns", "Hair_BuzzedFemale", "Hair_SimpleParted"],
    "beard": "Hair_Beard"
  },
  "anims": ["res://assets/models/anim/UAL2_Standard.glb", "res://assets/models/anim/AL_Standard.fbx"],
  "_animsHelp": "The game loads assets/models/anim/clips.res (only the clips listed under 'clips'). After changing 'clips', rebuild it: godot --headless --path . -- --bake-anims. The source files above are not exported. animPelvis = hip height of the animation rig.",
  "animPelvis": 0.9167,
  "default": { "armor": ["{s}_Peasant_Body", "{s}_Peasant_Legs"], "feet": ["{s}_Peasant_Feet"], "hands": [] },
  "armor": [
    { "match": ["Robe"], "parts": ["{s}_Peasant_Body", "{s}_Peasant_Legs"], "tint": "class" },
    { "match": ["Plate", "Cuirass"], "parts": ["{s}_Ranger_Body", "{s}_Ranger_Legs", "{s}_Ranger_Acc_Pauldron"], "tint": "c9d2dc" },
    { "match": ["Hauberk"], "parts": ["{s}_Ranger_Body", "{s}_Ranger_Legs"], "tint": "a9b2bd" },
    { "match": [""], "parts": ["{s}_Ranger_Body", "{s}_Ranger_Legs"] }
  ],
  "head": [
    { "match": ["Hood"], "parts": ["{s}_Ranger_Head_Hood"], "hideHair": true },
    { "match": ["Greathelm"], "proc": "greathelm", "hideHair": true, "kit": [{ "model": "armor/helm_knight", "bone": "Head", "pos": [0, 0.135, 0.02], "scale": 0.88 }] },
    { "match": ["Helm"], "proc": "helm", "hideHair": true, "kit": [{ "model": "armor/helm_knight", "bone": "Head", "pos": [0, 0.13, -0.03], "scale": 0.95 }] },
    { "match": ["Cap"], "proc": "cap", "hideHair": true },
    { "match": [""], "proc": "circlet", "kit": [{ "model": "armor/circlet_winged", "bone": "Head", "pos": [0, 0.12, 0.01], "scale": 0.8 }] }
  ],
  "hands": [
    { "match": ["Wraps"], "parts": ["{s}_Peasant_Arms"] },
    { "match": ["Gauntlets"], "parts": ["{s}_Ranger_Arms"], "tint": "c9d2dc" },
    { "match": [""], "parts": ["{s}_Ranger_Arms"] }
  ],
  "feet": [
    { "match": ["Greaves", "Sabatons"], "parts": ["{s}_Ranger_Feet"], "tint": "c9d2dc" },
    { "match": [""], "parts": ["{s}_Ranger_Feet"] }
  ],
  "cape": [
    { "_help": "Capes are an equipment slot (no cape when nothing is equipped). Kit capes hang down from their origin on the upper back; the piece swings back as the hero moves (Player). proc = the plain cloth cape, used when no kit piece loads." },
    { "match": ["Ember", "Umbral", "Shroud"], "proc": "cape", "kit": [{ "model": "armor/cape_red", "bone": "spine_03", "pos": [0, 0.12, -0.17], "rot": [-12, 0, 0], "scale": 0.7 }] },
    { "match": [""], "proc": "cape", "kit": [{ "model": "armor/cape_blue", "bone": "spine_03", "pos": [0, 0.12, -0.17], "rot": [-12, 0, 0], "scale": 0.7 }] }
  ],
