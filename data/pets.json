	"minChance": 0.01, "bossMinChance": 0.002, "maxChance": 0.99, "enrageDamage": 1.2,
	"cubeDropChance": 0.03, "dungeonCubeDropChance": 0.08, "bossCubeDropChance": 0.6, "gearDropChance": 0.02,
	"mountSpeedBase": 9, "mountSpeedPerSpd": 0.03, "mountSpeedMax": 15, "petHeight": 1.4, "mountHeight": 1.6,
	"_mount": "A-19 riding (one set of rules for the bought horse and for pets). mountMinHeight: a species whose own height (enemies.json h) is under this cannot be ridden unless its species entry says mountable. mountNear: the pet must be within this many metres to mount it. Speed = min(mountSpeedMax, mountSpeedBase + spd x mountSpeedPerSpd) x species mount.speed; sprint key gallops (x mountGallopMul) and drains the mount's stamina (mountStaminaBase + mountStaminaPerLevel x level, x mount.stamina) by mountGallopDrain a second; it refills by mountStaminaRegen a second and a spent mount must recover to mountTiredResume of its stamina before galloping again. Jump = hero jump x min(mountJumpMax, (mountJumpBase + mountJumpPerLevel x level) x mount.jump). Flying mounts (mount.fly; dragons and wyverns): Jump in the air takes off, Jump climbs (mountFlyClimb m/s), Roll dives (mountFlyDive), speed x mountFlySpeedMul, drains mountFlyDrain a second; with no stamina left it can only glide down at mountGlideSink m/s. mountSkillCd: seconds between uses of the ridden pet's skill (the pet order key while riding).",
	"mountMinHeight": 0.8, "mountNear": 7, "mountGallopMul": 1.35, "mountGallopDrain": 9, "mountStaminaBase": 60, "mountStaminaPerLevel": 2, "mountStaminaRegen": 7, "mountTiredResume": 0.3,
	"mountJumpBase": 1.05, "mountJumpPerLevel": 0.006, "mountJumpMax": 1.7, "mountFlySpeedMul": 1.5, "mountFlyClimb": 8, "mountFlyDive": 13, "mountFlyDrain": 5, "mountGlideSink": 3, "mountSkillCd": 2.5,
	"_hud": "A-20 pet frame on the HUD: hudPet 1 = shown (0 hides it).",
